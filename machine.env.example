# Machine-specific paths for the gm/ID lookup-table pipeline.
# Copy to machine.env and fill in the values for your machine.
# Values may use $HOME or reference earlier keys (e.g. $SIMDIR/raw).

# PDK model base card; how it is included (stat/global/{corner} sections or a
# single plain include) is set by SECTIONS in the process config module.
PDK_MODEL_FILE=$HOME/PDKs/tsmc40nm/models/spectre/crn40lp_2d5_v2d0_2.scs

# Process config module: selects sweep axes, model card and device size.
# Options: config_tsmcN40 (1.1 V core), config_tsmc18 (0.18 um).
CONFIG_MODULE=config_tsmcN40

# Spectre executable
SPECTRE_BIN=/opt/eda/cadence/SPECTRE181/tools.lnx86/bin/spectre

# Python interpreter with psf-parser (Python >= 3.10).
# On old systems (e.g. CentOS 7) build it with uv -- see README "运行环境".
PYTHON_BIN=$HOME/venvs/gmId313/bin/python

# Top directory holding the pipeline's larger data (raw sim + lookup tables)
SIMDIR=$HOME/simulation

# Transient raw simulation output (cleaned after extraction)
RAWDIR=$SIMDIR/raw

# Final .h5 lookup-table output directory
MATDIR=$SIMDIR/out

# Pipeline logs and failure markers
LOGDIR=$SIMDIR/logs

# Base temp dir for per-corner Spectre work directories
TMPDIR=$HOME/tmp

# Directory containing this project (scripts + machine.env); the pipeline
# auto-detects it from its own location, but you can override it here.
SCRIPTDIR=
